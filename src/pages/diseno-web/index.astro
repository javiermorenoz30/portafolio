---
import ServicePage from '../../components/ServicePage.astro';
const points = [
  {title:'Portfolio',text:'Sitios visuales para creativos, estudios y profesionales.'},
  {title:'Corporativa',text:'Arquitectura clara para empresas y servicios.'},
  {title:'Landing pages',text:'Páginas enfocadas en campañas, captación o lanzamientos.'},
  {title:'Responsive + SEO',text:'Mobile-first, rendimiento, semántica y estructura indexable.'}
];
---
<ServicePage
  title="Diseño Web en Caracas | Webs Creativas y Portfolios — Javier Moreno"
  description="Diseño web en Caracas para marcas y profesionales: landing pages, portfolios, sitios corporativos y experiencias responsive optimizadas para móvil y SEO."
  crumb="Diseño web"
  heroLine1="WEBS QUE"
  heroLine2="SE SIENTEN VIVAS."
  lede="Diseño y desarrollo webs visuales, rápidas y responsive para marcas, empresas y profesionales que quieren una presencia digital con personalidad y una experiencia móvil impecable."
  aside="DISEÑO WEB"
  heading="Diseño web que une identidad, experiencia y conversión"
  intro="Una web no debería sentirse como una plantilla con un logo encima. Diseño cada proyecto desde la jerarquía, la tipografía, el ritmo y la interacción para que la navegación forme parte de la identidad."
  subheading="Qué puedo construir"
  body="Landing pages, portfolios, webs corporativas, sitios para servicios, páginas de campaña y experiencias digitales especiales. Puedo trabajar diseño UI, front-end, estructura SEO, performance, animaciones y publicación en plataformas modernas como Cloudflare."
  {points}
/>
