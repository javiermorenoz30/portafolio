---
import ServicePage from '../../components/ServicePage.astro';
const points = [
  {title:'Retrato',text:'Editorial, personal, corporativo y lifestyle.'},
  {title:'Producto',text:'E-commerce, campañas, still life y contenido comercial.'},
  {title:'Campañas',text:'Concepto, dirección de arte, producción y retoque.'},
  {title:'Eventos',text:'Cobertura con enfoque documental y visual consistente.'}
];
---
<ServicePage
  title="Fotógrafo en Caracas | Fotografía Profesional — Javier Moreno"
  description="Fotógrafo en Caracas para retratos, producto, campañas, editorial, eventos y contenido de marca. Dirección visual, iluminación y retoque profesional."
  crumb="Fotografía"
  heroLine1="FOTOGRAFÍA"
  heroLine2="QUE DETIENE."
  lede="Fotografía profesional en Caracas para marcas, productos, retratos, campañas y proyectos editoriales. No se trata solo de una foto bonita: se trata de construir una imagen que comunique, se recuerde y tenga intención."
  aside="FOTOGRAFÍA"
  heading="Fotografía profesional con dirección visual"
  intro="Trabajo la fotografía como una extensión de la identidad de cada proyecto. Desde una sesión de producto hasta un retrato editorial o una campaña completa, cada decisión —luz, composición, color, textura y postproducción— responde a una idea clara."
  subheading="Qué puedo fotografiar"
  body="Retratos personales y corporativos, producto, gastronomía, moda, lifestyle, eventos, arquitectura, espacios, campañas publicitarias y contenido para redes sociales. También puedo desarrollar la dirección de arte completa para que las imágenes funcionen como un sistema y no como piezas aisladas."
  {points}
/>
