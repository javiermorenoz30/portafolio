import ServicePage from '../../components/ServicePage.astro';
const points = [
  {title:'Branding',text:'Logo, sistema visual, tipografía, color y aplicaciones.'},
  {title:'Campañas',text:'Conceptos visuales y piezas para lanzamientos o comunicación.'},
  {title:'Social',text:'Sistemas de contenido que mantienen coherencia y variedad.'},
  {title:'Editorial',text:'Presentaciones, informes, catálogos y piezas impresas o digitales.'}
];
---
<ServicePage
  title="Diseñador Gráfico en Caracas | Branding y Diseño Visual — Javier Moreno"
  description="Diseño gráfico y branding en Caracas: identidades visuales, campañas, redes sociales, presentaciones, editorial y dirección de arte para marcas."
  crumb="Diseño gráfico"
  heroLine1="DISEÑO QUE"
  heroLine2="SE RECONOCE."
  lede="Diseño gráfico, branding y dirección de arte para marcas que necesitan una identidad coherente, contemporánea y difícil de confundir con cualquier otra."
  aside="DISEÑO GRÁFICO"
  heading="Identidad visual con carácter, no decoración"
  intro="Diseño sistemas visuales que pueden vivir en una tarjeta, un post, una presentación, un empaque o una campaña completa sin perder personalidad. El objetivo es que cada pieza se sienta parte de la misma marca incluso antes de leer el nombre."
  subheading="Qué puedo diseñar"
  body="Identidades de marca, campañas, contenido para redes, presentaciones corporativas, piezas editoriales, material publicitario, sistemas gráficos, key visuals y dirección de arte. También conecto diseño con fotografía, motion y web cuando el proyecto necesita una experiencia más completa."
  {points}
/>
